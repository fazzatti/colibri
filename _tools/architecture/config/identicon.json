{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "baseUrl": "../../..",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["identicon/src/*"],
      "@colibri/core": ["core/mod.ts"],
      "colibri-internal/*": ["_internal/*"]
    },
    "skipLibCheck": true
  },
  "include": ["../../../identicon/**/*.ts"],
  "exclude": ["../../../identicon/**/*.test.ts"]
}
