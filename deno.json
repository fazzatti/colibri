{
  "workspace": [
    "./core",
    "./build-verification",
    "./identicon",
    "./rpc-streamer",
    "./webauth",
    "./plugins/*",
    "./test-tooling"
  ],
  "nodeModulesDir": "auto",
  "imports": {
    "jsr:@colibri/core": "./core",
    "jsr:@colibri/build-verification": "./build-verification",
    "jsr:@colibri/identicon": "./identicon",
    "jsr:@colibri/test-tooling": "./test-tooling",
    "jsr:@colibri/webauth": "./webauth",
    "@colibri/test-tooling": "./test-tooling/mod.ts",
    "@colibri/plugin-fee-bump": "./plugins/fee-bump/mod.ts",
    "colibri-internal/": "./_internal/",
    "colibri-tools/": "./_tools/",
    "stellar-sdk": "npm:@stellar/stellar-sdk@^17.0.1",
    "crypto": "node:crypto",
    "convee": "jsr:@fifo/convee@1.0.0",
    "@std/toml": "jsr:@std/toml@^1.0.11",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "@std/expect": "jsr:@std/expect@^1.0.0",
    "archunit": "npm:archunit@2.4.0",
    "crap4ts-tool": "npm:@alperlabs/crap4ts@0.2.1",
    "resvg-test": "npm:@resvg/resvg-js@2.6.2"
  },
  "tasks": {
    "check:consumers": "deno run -A _tools/consumers/check.ts",
    "inspect:error-boundaries": "deno run --allow-read --allow-env _tools/error-boundaries.ts",
    "docs:errors": "deno run --allow-read --allow-write --allow-env _tools/documentation.ts --write && deno fmt docs/reference/errors docs/SUMMARY.md",
    "test:docs": "deno test --allow-read --allow-write --allow-env --allow-run --clean _tools/documentation.unit.test.ts",
    "check:docs": "deno run --check --allow-read --allow-write --allow-env --allow-run _tools/documentation.ts --examples",
    "check": "deno run --allow-read --allow-run _tools/package-inventory.ts check",
    "check:jsr": "deno run --allow-read --allow-run _tools/package-inventory.ts doc",
    "check:slow-types": "deno publish --dry-run --allow-dirty",
    "check:package-versions": "deno test --allow-read --clean build-verification/src/core/evidence/package-version.unit.test.ts",
    "check:crap": "deno run --allow-read --allow-env _tools/check-crap.ts",
    "build:webauth-fixtures": "deno run -A _tools/build-webauth-fixtures.ts",
    "check:webauth-fixtures": "deno run -A _tools/build-webauth-fixtures.ts --check",
    "build:delegated-auth-fixtures": "deno run -A _tools/build-delegated-auth-fixtures.ts",
    "check:delegated-auth-fixtures": "deno run -A _tools/build-delegated-auth-fixtures.ts --check",
    "build:sep41-fixture": "deno run -A _tools/build-sep41-fixture.ts",
    "check:sep41-fixture": "deno run -A _tools/build-sep41-fixture.ts --check",
    "build:executable-ref-fixture": "deno run -A _tools/build-executable-ref-fixture.ts",
    "check:executable-ref-fixture": "deno run -A _tools/build-executable-ref-fixture.ts --check",
    "build:build-verification-fixtures": "deno run -A _tools/build-build-verification-fixtures.ts",
    "check:build-verification-fixtures": "deno run -A _tools/build-build-verification-fixtures.ts --check",
    "test": "deno test -A --parallel --clean --ignore='_*/' --coverage=coverage",
    "test:unit": "deno test -A --parallel --clean --ignore='_*/' --ignore='**/*.integration.test.ts' --ignore='**/*.testnet.integration.test.ts' --coverage=coverage",
    "test:integration": "deno test -A --parallel --clean --ignore='_*/' --ignore='**/*.unit.test.ts' --coverage=coverage",
    "test:lint-rules": "deno test --clean _tools/lint",
    "test:architecture": "deno test --allow-read --allow-write --allow-env --allow-sys=cpus --clean _tools/architecture",
    "test:file": "deno test -A --parallel --clean --ignore='_*/'"
  },
  "lint": {
    "plugins": ["./_tools/lint/no-relative-imports.ts"],
    "rules": {
      "exclude": ["explicit-function-return-type"]
    }
  },
  "compilerOptions": {
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "_*", "dist", "coverage"]
}
