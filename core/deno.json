    "./strkey": "./strkey.ts",
    "./values": "./values.ts",
    "./network": "./network.ts",
    "./rpc": "./rpc.ts",
    "./ledger": "./ledger.ts",
    "./contract": "./contract.ts",
    "./contract-read": "./contract-read.ts",
    "./classic-transaction": "./classic-transaction.ts",
    "./soroban-transaction": "./soroban-transaction.ts",
    "./simulation": "./simulation.ts",
    "./assets": "./assets.ts",
    "./events": "./events.ts",
    "./signers": "./signers.ts",
    "./sep1": "./sep1.ts"
  },
  "lint": {
    "plugins": [
      "../_tools/lint/enum-requires-own-file.ts",
