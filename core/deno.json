{
  "name": "@colibri/core",
  "version": "1.1.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./errors": "./errors.ts",
    "./strkey": "./strkey.ts"
  },
  "lint": {
    "plugins": [
      "../_tools/lint/enum-requires-own-file.ts",
      "../_tools/lint/no-relative-imports.ts"
    ]
  },
  "publish": {
    "include": [
      "mod.ts",
      "./**/*.ts",
      "README.md",
      "LICENSE",
      "./deno.json"
    ],
    "exclude": [
      "./**/*.test.ts"
    ]
  },
  "imports": {
    "@/": "./"
  }
}
